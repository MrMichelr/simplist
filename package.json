{
  "name": "simplist",
  "version": "4.0.0",
  "description": "A simple to-do list widget for Figma and FigJam",
  "scripts": {
    "build": "npm run build:ui && esbuild widget-src/code.tsx --bundle --outfile=dist/code.js --target=es2017 --minify",
    "dev": "npm run build:ui && esbuild widget-src/code.tsx --bundle --outfile=dist/code.js --target=es2017 --sourcemap --watch",
    "build:ui": "node -e \"require('fs').mkdirSync('dist',{recursive:true});require('fs').copyFileSync('widget-src/ui.html','dist/ui.html')\"",
    "lint": "eslint --ext .ts,.tsx widget-src",
    "lint:fix": "eslint --ext .ts,.tsx widget-src --fix",
    "tsc": "tsc --noEmit -p widget-src",
    "check": "npm run tsc && npm run lint"
  },
  "author": "Michel Rodriguez",
  "license": "UNLICENSED",
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "^0.15.0",
    "@figma/plugin-typings": "^1.93.0",
    "@figma/widget-typings": "*",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.21.1",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": { "project": "./widget-src/tsconfig.json" },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": ["error", {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }],
      "no-console": ["warn", { "allow": ["warn", "error"] }]
    }
  }
}
